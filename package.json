{
  "name": "@frankxai/suno-mcp-server",
  "version": "0.5.0",
  "packageManager": "pnpm@10.28.0",
  "description": "Music prompt workbench, sovereign lyric architecture & offline provider packet compiler; no generation backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "suno-mcp-server": "dist/index.js",
    "songcraft-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src/data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node test/songcraft.test.mjs",
    "test:phase1": "node --import tsx --test tests/phase1.test.ts",
    "test:songcraft": "node test/songcraft.test.mjs",
    "verify:package": "node tests/installed-consumer.mjs"
  },
  "keywords": [
    "suno",
    "mcp",
    "music",
    "music-dna",
    "prompt-strategy",
    "ai-music",
    "songwriting",
    "lyrics",
    "anti-slop",
    "claude-code",
    "model-context-protocol",
    "starlight",
    "gencreator"
  ],
  "author": "FrankX <frank@frankx.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/suno-mcp-server.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
